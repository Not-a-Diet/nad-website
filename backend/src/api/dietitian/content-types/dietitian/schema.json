{
  "kind": "collectionType",
  "collectionName": "dietitians",
  "info": {
    "singularName": "dietitian",
    "pluralName": "dietitians",
    "displayName": "Dietitian",
    "description": "Shared profiles for the team, appointment booking and article authors"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "role": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "shortBio": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bio": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "philosophy": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "profilePhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "education": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "degree": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "albo": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "associations": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "languages": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locations": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "specializations": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactLinks": {
      "type": "component",
      "repeatable": true,
      "component": "links.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "projects": {
      "type": "component",
      "repeatable": true,
      "component": "links.link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bookingLocations": {
      "type": "component",
      "repeatable": true,
      "component": "elements.booking-location",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "listed": {
      "type": "boolean",
      "default": true
    },
    "bookingEnabled": {
      "type": "boolean",
      "default": false
    },
    "email": {
      "type": "email",
      "private": true
    },
    "url": {
      "type": "string"
    },
    "sameAs": {
      "type": "json"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "dietitian"
    }
  }
}
