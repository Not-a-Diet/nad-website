{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn workspace backend build",
    "watchPatterns": [
      "/backend/**",
      "/package.json",
      "/yarn.lock",
      "/.yarnrc.yml",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "yarn workspace backend migrate:dietitians --allow-production --apply"
    ],
    "startCommand": "yarn workspace backend start"
  }
}
